#include <stdio.h>
#include <stdlib.h>

// Helper function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n;
    // Read the number of items
    if (scanf("%d", &n) != 1) return 0;

    int *values = (int *)malloc(n * sizeof(int));
    int *weights = (int *)malloc(n * sizeof(int));

    // Read values of the items
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }

    // Read weights of the items
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }

    int W;
    // Read the maximum knapsack capacity
    if (scanf("%d", &W) != 1) return 0;

    // Allocate 1D array for space-optimized Dynamic Programming DP[w]
    int *dp = (int *)calloc(W + 1, sizeof(int));

    // Process each item
    for (int i = 0; i < n; i++) {
        // Traverse the DP array backwards to avoid using the same item multiple times
        for (int w = W; w >= weights[i]; w--) {
            dp[w] = max(dp[w], values[i] + dp[w - weights[i]]);
        }
    }

    // The maximum value obtained within capacity W
    printf("%d\n", dp[W]);

    // Free allocated memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}

