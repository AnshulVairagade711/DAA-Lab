#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

struct Edge {
    int u, v, w;
};

void printPath(int parent[], int j) {
    if (parent[j] == -1) {
        printf("%d", j);
        return;
    }

    printPath(parent, parent[j]);
    printf("->%d", j);   // No spaces around ->
}

int main() {
    int V, E;

    if (scanf("%d", &V) != 1)
        return 0;

    if (scanf("%d", &E) != 1)
        return 0;

    struct Edge *edges = malloc(E * sizeof(struct Edge));

    if (edges == NULL)
        return 0;

    for (int i = 0; i < E; i++) {
        scanf("%d %d %d",
              &edges[i].u,
              &edges[i].v,
              &edges[i].w);
    }

    int src;
    scanf("%d", &src);

    long long *dist = malloc((V + 1) * sizeof(long long));
    int *parent = malloc((V + 1) * sizeof(int));

    if (dist == NULL || parent == NULL) {
        free(edges);
        free(dist);
        free(parent);
        return 0;
    }

    // Initialize distances and parents
    for (int i = 1; i <= V; i++) {
        dist[i] = LLONG_MAX;
        parent[i] = -1;
    }

    dist[src] = 0;

    // Bellman-Ford: relax all edges V-1 times
    for (int i = 1; i <= V - 1; i++) {
        int updated = 0;

        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (dist[u] != LLONG_MAX &&
                dist[u] + w < dist[v]) {

                dist[v] = dist[u] + w;
                parent[v] = u;
                updated = 1;
            }
        }

        // Optimization: stop if no distance changed
        if (!updated)
            break;
    }

    // Check for a reachable negative-weight cycle
    int has_negative_cycle = 0;

    for (int j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;

        if (dist[u] != LLONG_MAX &&
            dist[u] + w < dist[v]) {

            has_negative_cycle = 1;
            break;
        }
    }

    if (has_negative_cycle) {
        printf("Negative cycle detected\n");
    } else {
        for (int i = 1; i <= V; i++) {

            // Do not print the source vertex
            if (i == src)
                continue;

            if (dist[i] == LLONG_MAX) {
                printf("%d INF None\n", i);
            } else {
                printf("%d %lld ", i, dist[i]);
                printPath(parent, i);
                printf("\n");
            }
        }
    }

    free(edges);
    free(dist);
    free(parent);

    return 0;
}



